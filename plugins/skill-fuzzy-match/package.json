{
  "name": "@amazing-fish/dsh-plugin-skill-fuzzy-match",
  "version": "0.1.3",
  "description": "DSH client Cordis plugin: make the '/' slash menu match skills by ordered-subsequence fuzzy match (e.g. /web finds coding-web-search) instead of strict name-prefix startsWith.",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "inputTriggers"
      ]
    }
  },
  "files": [
    "client.js",
    "host.js",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skill",
    "slash-menu",
    "fuzzy-match"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazing-fish/dsh-plugins.git",
    "directory": "plugins/skill-fuzzy-match"
  },
  "homepage": "https://github.com/amazing-fish/dsh-plugins/tree/main/plugins/skill-fuzzy-match#readme",
  "bugs": {
    "url": "https://github.com/amazing-fish/dsh-plugins/issues"
  },
  "license": "MIT",
  "author": "amazing-fish",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
